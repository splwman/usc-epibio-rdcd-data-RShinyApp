load_category_dictionary <- function(path) {
if (!file.exists(path)) return(fallback_category_dict)
out <- tryCatch({
readxl::read_excel(path, sheet = "Category_Keywords") |>
dplyr::rename_with(clean_names) |>
dplyr::mutate(dplyr::across(dplyr::everything(), as_text))
}, error = function(e) fallback_category_dict)
needed <- c("category", "core_keywords", "synonyms_related_terms", "example_sources")
for (nm in needed) if (!nm %in% names(out)) out[[nm]] <- ""
out[, needed]
}
infer_categories <- function(search_text, dict) {
dict <- dict |>
dplyr::mutate(term_string = paste(category, core_keywords, synonyms_related_terms, sep = "; "))
purrr::map_chr(search_text, function(txt) {
scores <- purrr::map_int(seq_len(nrow(dict)), function(i) {
terms <- split_terms(dict$term_string[i])
sum(stringr::str_detect(txt, stringr::fixed(terms, ignore_case = TRUE)))
})
hits <- dict$category[scores > 0]
paste(head(hits, 4), collapse = "; ")
})
}
